# Add values locally; configure hosted secrets through Sites settings.
AUTH_MODE=meta
APP_ORIGIN=
META_APP_ID=
META_APP_SECRET=
# Secret of the Meta app that owns the Instagram webhook subscription.
# Defaults to META_APP_SECRET when both are the same app.
META_WEBHOOK_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=
META_API_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
TOKEN_ENCRYPTION_KEY=
LIVE_DELIVERY_ENABLED=false
# Server-only Razorpay credentials. Use one mode consistently (test or live).
# Live collection needs merchant activation/KYC and a verified settlement bank account.
# See docs/PAYMENTS.md. Never put secrets in NEXT_PUBLIC_ variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Independent webhook signing secret for /api/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=
# Plans must match displayed USD prices exactly: monthly 299 cents / yearly 2499 cents.
# INR plans require an intentional application pricing change; they cannot be substituted here.
RAZORPAY_MONTHLY_PLAN_ID=
RAZORPAY_YEARLY_PLAN_ID=
DELIVERY_WORKER_SECRET=
